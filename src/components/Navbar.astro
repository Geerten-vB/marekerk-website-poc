---
function formatLabel(value) {
  return value
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

const markdownFiles = Object.entries(import.meta.glob('../content/**/*.md', { eager: true }));

const navItems = Object.entries(
  markdownFiles.reduce((groups, [filePath]) => {
    const slug = filePath
      .replace(/\\/g, '/')
      .replace(/^.*?content\//, '')
      .replace(/\.md$/, '');

    const segments = slug.split('/').filter(Boolean);

    if (segments.length < 2 || segments[1] === 'index') {
      return groups;
    }

    const [folderName, fileName] = segments;
    const group = groups[folderName] ?? [];

    group.push({
      label: formatLabel(fileName),
      href: `/${folderName}/${fileName}`,
    });

    groups[folderName] = group;
    return groups;
  }, {})
)
  .map(([folderName, links]) => ({
    label: formatLabel(folderName),
    links: links.sort((a, b) => a.label.localeCompare(b.label)),
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="container nav-inner">
    <a class="brand" href="/">Marekerk</a>

    <div class="nav-groups">
      {navItems.map((group) => (
        <div class="nav-group">
          <button class="nav-label" type="button" aria-label={group.label}>{group.label}</button>

          <div class="nav-subitems" aria-label={`${group.label} submenu`}>
            {group.links.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</nav>
