---
import Navbar from '../components/Navbar.astro';
import * as page from '../content/home/landing.md';
import '../styles/global.css';

const { Content } = page;
const { title, subtitle } = page.frontmatter;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={subtitle} />
  </head>

  <body>
    <Navbar />

    <main>
      <section class="hero">
        <div class="container">
          <span class="eyebrow">Editable content demo</span>
          <h1>{title}</h1>
          <p>{subtitle}</p>
        </div>
      </section>

      <section class="content-section">
        <div class="container content-card">
          <article class="markdown">
            <Content />
          </article>
        </div>
      </section>

      <section class="callout">
        <div class="container">
          <strong>Developer-controlled HTML.</strong>
          <span>The text above came from Markdown.</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} My Website</div>
    </footer>
  </body>
</html>
